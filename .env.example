# ============================================================
# IRIS (Intelligent Resolution Incident System)
# Environment Configuration Template
# ============================================================
# Copy this file to .env and configure your Google Gemini API key:
#   copy .env.example .env
#
# Get your free Gemini API key from Google AI Studio:
#   https://aistudio.google.com/app/apikey

# Google Gemini API Key (Required for live AI synthesis & auto-classification)
# Leave blank to run in Manual Resolution + SQLite FTS5 BM25 retrieval mode.
GEMINI_API_KEY=

# Alternative key variable recognized by the Google GenAI SDK:
# GOOGLE_API_KEY=

# Active Gemini Model (Default: gemini-2.5-flash)
# Supported options: gemini-2.5-flash, gemini-2.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Backend Server Port (Default: 8000)
PORT=8000
